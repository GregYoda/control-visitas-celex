<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config base para el hosting en IIS.

  Propósito: DESACTIVAR el módulo WebDAV de IIS, que de lo contrario intercepta
  los verbos PUT y DELETE y responde "405 Method Not Allowed" ANTES de que la
  petición llegue a la API. En esta app eso rompía específicamente el guardado
  de la edición de visitas (PUT /api/visitas/{id}); el resto (GET/POST: login,
  listar, registrar, cancelar, foto) no se ve afectado porque WebDAV no toca
  esos verbos. En desarrollo con Kestrel (dotnet run) no existe WebDAV, por eso
  el problema solo se manifestaba en producción bajo IIS.

  Este archivo es solo la BASE: al ejecutar `dotnet publish`, el SDK de .NET
  transforma este web.config e inyecta automáticamente el handler y el elemento
  <aspNetCore> del ASP.NET Core Module (ANCM). Los <remove> de WebDAV se
  conservan en la salida publicada.
-->
<configuration>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
